# ============================================================
# VoiceLeads — copy to .env and fill in. NEVER commit .env.
# Generate secrets: node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('hex'))"
# ============================================================

NODE_ENV=development
PORT=3000
BASE_URL=https://your-domain.com   # must be HTTPS in production (bKash + ElevenLabs require it)

# ---- Security ----
SESSION_SECRET=change-me-64-hex-chars
WEBHOOK_SECRET=shared-secret-for-twilio-voice-callbacks
ADMIN_TOKEN=super-admin-bootstrap-token
AES_KEY=change-me-64-hex-chars     # used to encrypt provider API keys at rest

# ---- Database ----
# Start with SQLite (zero setup). Migrate to Neon/Supabase Postgres when you have paying customers.
DATABASE_URL=sqlite://./data/app.db

# ---- Google Gemini (conversation brain + lead extraction) ----
# FREE-tier key: https://aistudio.google.com/apikey  ("Get API key in Google AI Studio")
# gemini-2.5-flash free limits ≈10 requests/min, 250/day — fine for testing.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback brain (used only if GEMINI_API_KEY is absent):
# ANTHROPIC_API_KEY=sk-ant-...

# ---- ElevenLabs (voices / conversational AI) ----
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_AGENT_ID=              # agent id from app.elevenlabs.io ("Agents" product)

# ---- bKash (merchant subscription payments) ----
# Create an app on https://developer.bka.sh after your merchant account is approved.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_ID_TOKEN=                   # from the merchant agreement / onboarding
BKASH_BASE_URL=https://tokenized.pay.bka.sh          # sandbox: https://tokenized.sandbox.bka.sh
# Callback URLs you register in the bKash dashboard must match:
#   $BASE_URL/billing/bkash/callback/{agreement|payment|refund}

# ---- Telephony carrier for OUTBOUND campaign calls (pick ONE adapter) ----
# Vapi hosts Gemini/Twilio voices + gives you a phone number in one product.
# In the Vapi dashboard create an assistant with Model provider=Google, model=gemini-2.5-flash.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Twilio alternative (bring-your-own SIP trunk to ElevenLabs):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Call budget / abuse guards ----
MAX_CALL_SECONDS=300
MAX_CONCURRENT_CALLS_PER_WORKSPACE=2
DAILY_SPEND_CAP_BDT=5000
